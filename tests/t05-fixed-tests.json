      "expected": "`1,050,000원`"
    },
    {
      "id": "TEST-04",
      "description": "예상 수수료 계산",
      "input": "환전 예정 금액 `1,050,000원`, 수수료율 `1.5%`",
      "expected": "`15,750원`"
    },
    {
      "id": "TEST-05",
      "description": "실제 환전 금액 계산",
      "input": "환전 예정 금액 `1,050,000원`, 수수료 `15,750원`",
      "expected": "`1,034,250원`"
    },
    {
      "id": "TEST-06",
      "description": "예상 외화 수령액 계산",
      "input": "실제 환전 금액 `1,034,250원`, `100 JPY = 930원`",
      "expected": "약 `111,209 JPY`"
    },
    {
      "id": "TEST-07",
      "description": "국가 변경",
      "input": "계산 후 다른 여행 국가 선택",
      "expected": "변경한 국가의 통화와 환율로 다시 계산된다."
    },
    {
      "id": "TEST-08",
      "description": "잘못된 여행 예산",
      "input": "`0`, 음수, 숫자가 아닌 값",
      "expected": "정상 계산하지 않고 안내를 표시한다."
    },
    {
      "id": "TEST-09",
      "description": "잘못된 환전 비율",
      "input": "`-1%`, `101%`",
      "expected": "0~100% 범위를 벗어난 값을 정상 계산하지 않는다."
    },
    {
      "id": "TEST-10",
      "description": "초기화",
      "input": "값 입력 및 계산 후 초기화",
      "expected": "입력값과 계산 결과가 초기 상태로 돌아간다."
    }
